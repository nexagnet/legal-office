# Cài vào /etc/caddy/Caddyfile. SITE_ADDRESS đặt trong /etc/default/caddy hoặc systemd drop-in:
#   - trước khi có DNS: SITE_ADDRESS=:80        (HTTP theo IP, chỉ để thử, không nhập dữ liệu thật)
#   - sau khi trỏ DNS:  SITE_ADDRESS=thihanhandansuhaibatrung.vn   (Caddy tự lấy và gia hạn chứng chỉ HTTPS)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# API đã có rate limit theo IP; Caddy đặt X-Forwarded-For nên TRUST_PROXY=1 ở API là đúng.
		health_uri /
		health_interval 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
