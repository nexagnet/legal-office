# Mẫu /opt/legal-office/.env (quyền 600, chủ sở hữu dev). KHÔNG commit bản thật. Các giá trị bí mật đặt trực tiếp trên server.
# --- Cơ sở dữ liệu (Postgres 17 trên host, chỉ 127.0.0.1) ---
DATABASE_URL=postgres://legal_office:CHANGE_ME@127.0.0.1:5432/legal_office     # vai chủ DB, chỉ dùng cho migration lúc API khởi động
APP_DATABASE_URL=postgres://legal_app:CHANGE_ME@127.0.0.1:5432/legal_office    # vai legal_app, API dùng cái này
APP_DB_ROLE=legal_app
# --- Web ---
WEB_ORIGIN=https://thihanhandansuhaibatrung.vn
PUBLIC_WEB_URL=https://thihanhandansuhaibatrung.vn
TENANT_ID=CHANGE_ME_UUID_TU_BOOTSTRAP_TENANT
TENANT_NAME=CHANGE_ME
# --- Kho tệp R2 (bucket lo-files) ---
FILE_STORE=r2
R2_ACCOUNT_ID=
R2_BUCKET=lo-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# --- Sao lưu (bucket lo-backup, token riêng) ---
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=lo-backup
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# --- Tuỳ chọn ---
MAIL_SETTINGS_KEY=
ALERT_WEBHOOK_URL=
