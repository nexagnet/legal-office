# Mẫu /opt/legal-office/.env (quyền 600, chủ sở hữu dev). KHÔNG commit bản thật. Các giá trị bí mật đặt trực tiếp trên server.
# --- Cơ sở dữ liệu (Postgres 17 trên host, chỉ 127.0.0.1) ---
DATABASE_URL=postgres://legal_office:CHANGE_ME@127.0.0.1:5432/legal_office     # vai chủ DB, chỉ dùng cho migration lúc API khởi động
APP_DATABASE_URL=postgres://legal_app:CHANGE_ME@127.0.0.1:5432/legal_office    # vai legal_app, API dùng cái này
APP_DB_ROLE=legal_app
# --- Web ---
WEB_ORIGIN=https://thihanhandansuhaibatrung.vn
PUBLIC_WEB_URL=https://thihanhandansuhaibatrung.vn
TENANT_ID=CHANGE_ME_UUID_TU_BOOTSTRAP_TENANT
TENANT_NAME=CHANGE_ME
# Lịch nhắc hạn và dọn scan mặc định chạy cho đúng TENANT_ID ở trên; chỉ đặt hai biến sau khi cần danh sách khác (ngăn cách bằng dấu phẩy).
# REMINDER_TENANT_IDS=
# SCAN_PURGE_TENANT_IDS=
# --- Kho tệp R2 (bucket lo-files) ---
FILE_STORE=r2
# Chỉ để thử với dữ liệu giả khi chưa có khoá R2: FILE_STORE=local và FILE_STORE_DIR=/tmp/legal-office-files (mất dữ liệu khi container tạo lại).
FILE_STORE_DIR=
R2_ACCOUNT_ID=
R2_BUCKET=lo-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# --- Sao lưu (bucket lo-backup, token riêng) ---
# Vai legal_backup (LOGIN + BYPASSRLS + pg_read_all_data) tạo bằng postgres; KHÔNG dùng vai chủ DB vì RLS bắt buộc chặn pg_dump.
BACKUP_DATABASE_URL=postgres://legal_backup:CHANGE_ME@127.0.0.1:5432/legal_office
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=lo-backup
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# --- Tuỳ chọn ---
MAIL_SETTINGS_KEY=
ALERT_WEBHOOK_URL=
# --- OCR nền (service ocr trong compose; mặc định bật cho tài liệu mới và tài liệu cũ khách tự tải) ---
# LEGACY_OCR_ENABLED=1       # 0 = không OCR tài liệu cũ
# LEGACY_SEARCH_ENABLED=1    # 0 = ẩn tìm kiếm tài liệu cũ
# OCR_MIN_FREE_MB=250        # RAM trống (MB) dưới mức này thì OCR tạm nghỉ
# OCR_TENANT_IDS=            # mặc định = TENANT_ID
